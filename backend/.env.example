# Resend transactional email API key (https://resend.com) — used for OTP/password-reset emails
RESEND_API_KEY=your_resend_api_key_here

# Verified sender email address configured in your Resend account
SENDER_EMAIL=onboarding@resend.dev

# Secret used to sign JWT auth tokens. Use a long, random value in every environment;
# never reuse the example value and never commit real secrets.
JWT_SECRET=replace_with_a_long_random_secret

# Active banking provider gateway: mock | paystack | sterling
BANKING_PROVIDER=mock

# Optional: Paystack secret key, required when BANKING_PROVIDER=paystack
PAYSTACK_SECRET_KEY=

# Optional: Sterling Bank BaaS credentials, required when BANKING_PROVIDER=sterling
STERLING_API_KEY=
STERLING_API_SECRET=
